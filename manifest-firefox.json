{
  "manifest_version": 2,
  "name": "Auto-Close Ignition",
  "version": "1.0",
  "description": "Auto-close Ignition login windows after 3 seconds so you don't have to.",
  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "autoclose-ignition@gamemore.com"
    }
  }
}
