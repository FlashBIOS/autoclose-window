{
  "manifest_version": 2,
  "name": "Auto-Close Window",
  "version": "1.0",
  "description": "Auto-closes tabs after 3 seconds if the domain and title match a pre-defined list.",
  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "autoclose-window@your-domain.example"
    }
  }
}
